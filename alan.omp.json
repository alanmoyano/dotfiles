{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "git-changed": "#F2E5A5",
    "git-conflict": "#F78C6C",
    "git-nice": "#D7F2A5",
    "git-remote": "#b6a5f2",
    "os": "#cadbf4",
    "path": "#f4cae0",
    "red": "#f5635c",
    "status": "#eea880",
    "text-dark": "#011627",
    "text-light": "#FCF6F6",
    "time": "#b8bae6"
  },
  "console_title_template": "{{ if .Root }}⚡ {{ end }}{{ .UserName }} ➔ {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "overflow": "break",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": " {{ .Icon }} ",
          "foreground": "p:text-dark",
          "background": "p:os",
          "type": "os",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "home_icon": "~",
            "mapped_locations": {
              "\\\\wsl.localhost\\Ubuntu\\": "Ubuntu"
            },
            "max_depth": 3,
            "style": "agnoster_short"
          },
          "trailing_diamond": "\ue0b4",
          "template": " \uf07b {{ .Path }} ",
          "foreground": "p:text-dark",
          "background": "p:path",
          "type": "path",
          "style": "diamond"
        },
        {
          "properties": {
            "branch_gone_icon": "\uf4ad",
            "branch_icon": "\ue725 ",
            "branch_identical_icon": "",
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": true
          },
          "trailing_diamond": "\ue0b4",
          "template": " {{ .UpstreamIcon }} {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} {{ .Staging.String }}{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }} ",
          "foreground": "p:text-dark",
          "background": "p:git-nice",
          "type": "git",
          "style": "diamond",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:git-changed{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:git-conflict{{ end }}",
            "{{ if gt .Ahead 0 }}p:git-remote{{ end }}",
            "{{ if gt .Behind 0 }}p:git-remote{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": " {{ if gt .Code 0 }}{{ .Code }}{{ else }}\uf00c{{ end }} ",
          "foreground": "p:text-dark",
          "background": "p:status",
          "type": "status",
          "style": "diamond",
          "background_templates": [
            "{{ if gt .Code 0 }}p:red{{end}}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none",
            "style": "amarillo",
            "threshold": 5
          },
          "trailing_diamond": "\ue0b4",
          "template": " {{ .FormattedMs }} \uf252",
          "foreground": "p:text-dark",
          "background": "p:time",
          "type": "executiontime",
          "style": "diamond"
        }
      ]
    }
  ],
  "version": 3,
  "final_space": true
}